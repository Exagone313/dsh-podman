{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-expressions": ["error", { "allowTernary": true }]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["dist", "node_modules", "bin", "src/generated"]
}
