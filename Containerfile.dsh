FROM node:24-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV DISABLE_AUTOUPDATER=1
ENV DO_NOT_TRACK=1
ENV DSH_TELEMETRY_MODE=DISABLED
ENV DSH_TELEMETRY_OTLP_URL=https://dsh-telemetry-disabled.invalid/v1/logs

ARG DSH_VERSION=0.1.5-rc.2
# Keep in sync with package.json's packageManager field: the profiles dsh
# manages install their plugins with this pnpm.
ARG PNPM_VERSION=12.4.1
RUN npm install -g pnpm@${PNPM_VERSION} @deepseek-ai/dsh@${DSH_VERSION} \
    && npm cache clean --force

RUN mkdir -p /opt/dsh
COPY ./dsh/defaults.cordis.patch.yml /opt/dsh/

CMD ["dsh", "--profile", "web", "--patch", "/opt/dsh/defaults.cordis.patch.yml", "--no-open"]
