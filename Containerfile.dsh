FROM node:26-slim@sha256:36793bcbb160a6a16cede1e62b93f84e26b78a972a8a4c0b879c1c12f22761ec

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV DISABLE_AUTOUPDATER=1
ENV DO_NOT_TRACK=1
ENV DSH_TELEMETRY_MODE=DISABLED
ENV DSH_TELEMETRY_OTLP_URL=https://dsh-telemetry-disabled.invalid/v1/logs

ARG DSH_VERSION=0.2.1-rc.4
# Keep in sync with package.json's packageManager field: the profiles dsh
# manages install their plugins with this pnpm.
ARG PNPM_VERSION=12.15.0
RUN npm install -g pnpm@${PNPM_VERSION} @deepseek-ai/dsh@${DSH_VERSION} \
    && npm cache clean --force

# The dsh-podman plugin version this image ships; the entrypoint installs it
# into the profile at container start. Release builds pass the tag.
ARG DSH_PODMAN_PLUGIN_VERSION
RUN test -n "$DSH_PODMAN_PLUGIN_VERSION" \
    || { echo "error: build with --build-arg DSH_PODMAN_PLUGIN_VERSION=<version>" >&2; exit 1; }
ENV DSH_PODMAN_PLUGIN_VERSION=${DSH_PODMAN_PLUGIN_VERSION}

RUN mkdir -p /opt/dsh
COPY ./dsh/defaults.cordis.patch.yml /opt/dsh/
COPY ./dsh/entrypoint.sh /opt/dsh/entrypoint.sh
COPY ./dsh/dsh-busy.sh /opt/dsh/dsh-busy.sh
COPY ./dsh/patch-wildcard-host.mjs /opt/dsh/patch-wildcard-host.mjs
RUN chmod 0755 /opt/dsh/entrypoint.sh /opt/dsh/dsh-busy.sh \
    && node /opt/dsh/patch-wildcard-host.mjs \
        /usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-host-webserver/lib/index.js \
    && rm -f /opt/dsh/patch-wildcard-host.mjs

ENTRYPOINT ["/opt/dsh/entrypoint.sh"]
CMD ["dsh", "--profile", "web", "--patch", "/opt/dsh/defaults.cordis.patch.yml", "--no-open"]
