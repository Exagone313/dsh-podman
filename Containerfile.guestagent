FROM scratch
ENV PATH=/bin
ARG TARGETOS
ARG TARGETARCH
COPY bin/${TARGETOS}-${TARGETARCH}/dsh-podman-guest-agent /bin/dsh-podman-guest-agent
COPY LICENSE.pkg /usr/share/licenses/dsh-podman/LICENSE
ENTRYPOINT ["/bin/dsh-podman-guest-agent"]
