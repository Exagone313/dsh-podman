FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -tags='containers_image_openpgp exclude_graphdriver_btrfs exclude_graphdriver_devicemapper' -trimpath -ldflags='-s -w' -o /out/dsh-orchestrator ./cmd/dsh-orchestrator

FROM scratch
COPY --from=build /out/dsh-orchestrator /usr/local/bin/dsh-orchestrator
ENTRYPOINT ["/usr/local/bin/dsh-orchestrator"]
