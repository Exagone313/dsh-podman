[Unit]
Description=dsh-podman orchestrator
Requires=podman.socket
After=podman.socket

[Container]
Network=pasta:--mtu,1500,--dns-forward,1.0.0.1
DNS=1.0.0.1
DNS=1.1.1.1
Image=ghcr.io/exagone313/dsh-podman/orchestrator:1
ContainerName=dsh-podman-orchestrator
AutoUpdate=registry
ReadOnly=true

Volume=%h/project:%h/project:ro
Environment=DSH_PODMAN_HOST_PROJECTS_ROOT=%h/project
Environment=DSH_PODMAN_PROJECTS_ROOT=%h/project

Volume=%t/podman/podman.sock:/run/podman/podman.sock
Environment=DSH_PODMAN_ORCHESTRATOR_PODMAN_SOCKET=unix:///run/podman/podman.sock

Volume=%h/.dsh/dsh-podman/state:%h/.dsh/dsh-podman/state
Environment=DSH_PODMAN_ORCHESTRATOR_STATE=%h/.dsh/dsh-podman/state

Volume=%h/.dsh/dsh-podman/apk-cache:%h/.dsh/dsh-podman/apk-cache
Environment=DSH_PODMAN_HOST_APK_CACHE=%h/.dsh/dsh-podman/apk-cache
Volume=%h/.dsh/dsh-podman/apt-cache:%h/.dsh/dsh-podman/apt-cache
Environment=DSH_PODMAN_HOST_APT_CACHE=%h/.dsh/dsh-podman/apt-cache
Volume=%h/.dsh/dsh-podman/pacman-cache:%h/.dsh/dsh-podman/pacman-cache
Environment=DSH_PODMAN_HOST_PACMAN_CACHE=%h/.dsh/dsh-podman/pacman-cache

Volume=%t/dsh-podman:/run/dsh-podman
Environment=DSH_PODMAN_HOST_SOCKETS_ROOT=%t/dsh-podman
Environment=DSH_PODMAN_SOCKETS_ROOT=/run/dsh-podman

Environment=DSH_PODMAN_GUEST_AGENT_IMAGE=ghcr.io/exagone313/dsh-podman/guest-agent
Environment=DSH_PODMAN_GUEST_AGENT_IMAGE_USE_VERSION_TAG=true

# Must never point to a directory in the DSH root (~/.dsh) for security reasons
Environment=DSH_PODMAN_HOST_SKILL_DIR=%h/.agents/skills

[Service]
ExecStartPre=/usr/bin/env mkdir -p -m 0700 %h/project ; /usr/bin/env mkdir -p -m 0700 %t/dsh-podman ; /usr/bin/env chmod 0700 %t/dsh-podman ; /usr/bin/env mkdir -p -m 0700 %h/.dsh/dsh-podman/state ; /usr/bin/env mkdir -p -m 0755 %h/.dsh/dsh-podman/apk-cache ; /usr/bin/env mkdir -p -m 0755 %h/.dsh/dsh-podman/apt-cache ; /usr/bin/env mkdir -p -m 0755 %h/.dsh/dsh-podman/pacman-cache ; /usr/bin/env mkdir -p -m 0700 %h/.agents/skills
Restart=on-failure
RestartSec=3
SuccessExitStatus=0 143

[Install]
WantedBy=default.target
